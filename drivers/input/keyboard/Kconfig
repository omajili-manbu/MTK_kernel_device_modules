# Input core configuration
#

if INPUT_KEYBOARD

config KEYBOARD_MTK_KPD
	tristate "MediaTek Keypad Support"
	depends on OF && HAVE_CLK
	help
	  Say Y here if you want to use the keypad on MediaTek SoCs.
	  If unsure, say N.
	  To compile this driver as a module, choose M here: the
	  module will be called mtk-kpd.

config DEVICE_MODULES_KEYBOARD_MTK_PMIC
	tristate "MediaTek PMIC keys support"
	# rodin stage2: rodin keys cell lives in the SPMI PMIC MFD
	# (mtk-spmi-pmic.c registers cell "mtk-pmic-keys"/of_compatible
	# "mediatek,mt6363-keys"); MT6397-style MFD core is not present on
	# this device, so accept it as an alternative provider.
	depends on DEVICE_MODULES_MFD_MT6397 || MFD_MTK_SPMI_PMIC
	help
	  Say Y here if you want to use the pmic keys (powerkey/homekey).

	  To compile this driver as a module, choose M here: the
	  module will be called mtk-pmic-keys.

endif
